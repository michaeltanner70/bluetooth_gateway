# Kopieren nach secrets.yaml und ausfüllen (secrets.yaml ist in .gitignore)
wifi_ssid: "DEIN_WLAN"
wifi_password: "DEIN_PASSWORT"

# API-Schlüssel, gilt auch für die OTA-Verschlüsselung:
# im ESPHome Dashboard generieren oder `openssl rand -base64 32`
bt_gateway_api_key: "BASE64_KEY_32_BYTES="

# Fallback-Hotspot, falls die WLAN-Verbindung fehlschlägt (Passwort mind. 8 Zeichen)
bt_gateway_fallback_ap_ssid: "bt-gateway"
bt_gateway_fallback_ap_password: "AP_PASSWORT"

# Für common/diagnostics.yaml: BSSIDs der Access Points
mac_bssid_ug: "AA:BB:CC:DD:EE:01"
mac_bssid_garten: "AA:BB:CC:DD:EE:02"
mac_bssid_dg: "AA:BB:CC:DD:EE:03"
mac_bssid_eg_west: "AA:BB:CC:DD:EE:04"
mac_bssid_eg_ost: "AA:BB:CC:DD:EE:05"
